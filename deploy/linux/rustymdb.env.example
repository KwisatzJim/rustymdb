# Copy to /srv/rustymdb/rustymdb.env for the example Linux service.
RUSTYMDB_BIND=127.0.0.1:3000
RUSTYMDB_DATA_DIR=/srv/rustymdb/data

# Maximum cached image payload in MiB (1–16384); default 512.
RUSTYMDB_IMAGE_CACHE_MB=512

# Additional trusted LAN/proxy authorities; include ports when clients use them.
# Required for client addresses used with a wildcard bind.
# RUSTYMDB_ALLOWED_HOSTS=192.168.1.20:3000,movies.home.arpa
